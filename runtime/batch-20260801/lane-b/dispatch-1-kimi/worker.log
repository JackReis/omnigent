    },\n                \"mentionCount\": 2,\n                \"sources\": [\n                    {\n                        \"kind\": \"description\",\n                        \"sourceRecordId\": null,\n                        \"label\": \"description\",\n                        \"matchedText\": \"JAC-4344\"\n                    },\n                    {\n                        \"kind\": \"comment\",\n                        \"sourceRecordId\": \"e89ad341-bf22-4435-ac23-e31d5a75c972\",\n                        \"label\": \"comment\",\n                        \"matchedText\": \"JAC-4344\"\n                    }\n                ]\n            },\n            {\n                \"issue\": {\n                    \"id\": \"2583c255-9fc2-4b5c-accc-e1d358122b27\",\n                    \"identifier\": \"JAC-3268\",\n                    \"title\": \"Implement Phase 3: Concurrency + UI Swimlanes\",\n                    \"status\": \"done\",\n                    \"priority\": \"medium\",\n                    \"assigneeAgentId\": \"f1ef5e14-d8d4-4030-9e37-7b4fc764ce3d\",\n                    \"assigneeUserId\": null\n                },\n                \"mentionCount\": 1,\n                \"sources\": [\n                    {\n                        \"kind\": \"description\",\n                        \"sourceRecordId\": null,\n                        \"label\": \"description\",\n                        \"matchedText\": \"JAC-3268\"\n                    }\n                ]\n            }\n        ],\n        \"inbound\": [\n            {\n                \"issue\": {\n                    \"id\": \"897f48f8-9e93-4b03-89e9-8d87434677cc\",\n                    \"identifier\": \"JAC-4344\",\n                    \"title\": \"Corrected parallel-session soak harness (scheduler-driven, functional low-cost agent)\",\n                    \"status\": \"blocked\",\n                    \"priority\": \"medium\",\n                    \"assigneeAgentId\": \"a1e8cb0d-9132-4b3b-b7a3-8b53cdb