{"role":"tool","tool_call_id":"tool_k7NN0ZTX5vI9wprkhBr5rHlY","content":"4550\t\n4551\t  // Common malformed path when companyId is empty in \"/api/companies/{companyId}/issues\".\n4552\t  router.get(\"/issues\", (_req, res) => {\n4553\t    res.status(400).json({\n4554\t      error: \"Missing companyId in path. Use /api/companies/{companyId}/issues.\",\n4555\t    });\n4556\t  });\n4557\t\n4558\t  router.get(\"/companies/:companyId/search/extract\", async (req, res) => {\n4559\t    const companyId = req.params.companyId as string;\n4560\t    assertCompanyAccess(req, companyId);\n4561\t    const companyScopeDecision = await access.decide({\n4562\t      actor: req.actor,\n4563\t      action: \"company_scope:read\",\n4564\t      resource: { type: \"company\", companyId },\n4565\t    });\n4566\t    if (!companyScopeDecision.allowed) {\n4567\t      res.status(403).json({ error: \"Company search is outside this actor's authorization boundary\" });\n4568\t      return;\n4569\t    }\n4570\t    const parsedQuery = companySearchExtractQuerySchema.safeParse(req.query);\n4571\t    if (!parsedQuery.success) {\n4572\t      res.status(400).json({\n4573\t        error: parsedQuery.error.issues[0]?.message ?? \"Invalid extract search query\",\n4574\t      });\n4575\t      return;\n4576\t    }\n4577\t    const rateLimit = searchRateLimiter.consume(companySearchRateLimitActor(req, companyId));\n4578\t    res.setHeader(\"X-RateLimit-Limit\", String(rateLimit.limit));\n4579\t    res.setHeader(\"X-RateLimit-Remaining\", String(rateLimit.remaining));\n4580\t    if (!rateLimit.allowed) {\n4581\t      res.setHeader(\"Retry-After\", String(rateLimit.retryAfterSeconds));\n4582\t      res.status(429).json({\n4583\t        error: \"Search rate limit exceeded\",\n4584\t        retryAfterSeconds: rateLimit.retryAfterSeconds,\n4585\t      });\n4586\t      return;\n4587\t    }\n4588\t    const result = await getSearchService().extract(companyId, parsedQuery.data);\n4589\t    res.json(result);\n4590\t  });\n4591\t\n4592\t  router.get(\"/companies/:companyId/search\", async (req, res) => {\n4593\t    const companyId = req.params.companyId as string;\n4594\t    assertCompanyAccess(req, companyId);\n4595\t    const companyScopeDecision = await access.decide({\n4596\t      actor: req.actor,\n4597\t      action: \"company_scope:read\",\n4598\t      resource: { type: \"company\", companyId },\n4599\t    });\n4600\t    if (!companyScopeDecision.allowed) {\n4601\t      res.status(403).json({ error: \"Company search is outside this actor's authorization boundary\" });\n4602\t      return;\n4603\t    }\n4604\t    const parsedQuery = companySearchQuerySchema.safeParse(req.query);\n4605\t    if (!parsedQuery.success) {\n4606\t      res.status(400).json({\n4607\t        error: parsedQuery.error.issues[0]?.message ?? \"Invalid search query\",\n4608\t      });\n4609\t      return;\n4610\t    }\n4611\t    let query = parsedQuery.data;\n4612\t    if (query.assigneeUserId === \"me\") {\n4613\t      if (req.actor.type !== \"board\" || !req.actor.userId) {\n4614\t        res.status(403).json({ error: \"assigneeUserId=me requires board authentication\" });\n4615\t        return;\n4616\t      }\n4617\t      query = { ...query, assigneeUserId: req.actor.userId };\n4618\t    }\n4619\t    const rateLimit = searchRateLimiter.consume(companySearchRateLimitActor(req, companyId));\n4620\t    res.setHeader(\"X-RateLimit-Limit\", String(rateLimit.limit));\n4621\t    res.setHeader(\"X-RateLimit-Remaining\", String(rateLimit.remaining));\n4622\t    if (!rateLimit.allowed) {\n4623\t      res.setHeader(\"Retry-After\", String(rateLimit.retryAfterSeconds));\n4624\t      res.status(429).json({\n4625\t        error: \"Search rate limit exceeded\",\n4626\t        retryAfterSeconds: rateLimit.retryAfterSeconds,\n4627\t      });\n4628\t      return;\n4629\t    }\n4630\t    const result = await getSearchService().search(companyId, query);\n4631\t    res.json(result);\n4632\t  });\n4633\t\n4634\t  router.get(\"/companies/:companyId/issues\", async (req, res) => {\n4635\t    const startedAt = Date.now();\n4636\t    const companyId = req.params.companyId as string;\n4637\t    assertCompanyAccess(req, companyId);\n4638\t    if (isTaskBridgeKeyActor(req)) {\n4639\t      res.status(403).json({ error: \"Task bridge keys cannot use company-wide issue list APIs\" });\n4640\t      return;\n4641\t    }\n4642\t    const assigneeUserFilterRaw = req.query.assigneeUserId as string | undefined;\n4643\t    const touchedByUserFilterRaw = req.query.touchedByUserId as string | undefined;\n4644\t    const inboxArchivedByUserFilterRaw = req.query.inboxArchivedByUserId as string | undefined;\n4645\t    const unreadForUserFilterRaw = req.query.unreadForUserId as string | undefined;\n4646\t    const assigneeUserId =\n4647\t      assigneeUserFilterRaw === \"me\" && req.actor.type === \"board\"\n4648\t        ? req.actor.userId\n4649\t        : assigneeUserFilterRaw;\n4650\t    const touchedByUserId =\n4651\t      touchedByUserFilterRaw === \"me\" && req.actor.type === \"board\"\n4652\t        ? req.actor.userId\n4653\t        : touchedByUserFilterRaw;\n4654\t    const inboxArchivedByUserId =\n4655\t      inboxArchivedByUserFilterRaw === \"me\" && req.actor.type === \"board\"\n4656\t        ? req.actor.userId\n4657\t        : inboxArchivedByUserFilterRaw;\n4658\t    const unreadForUserId =\n4659\t      unreadForUserFilterRaw === \"me\" && req.actor.type === \"board\"\n4660\t        ? req.actor.userId\n4661\t        : unreadForUserFilterRaw;\n4662\t    const rawLimit = req.query.limit as string | undefined;\n4663\t    const parsedLimit = rawLimit !== undefined && /^\\d+$/.test(rawLimit)\n4664\t      ? Number.parseInt(rawLimit, 10)\n4665\t      : null;\n4666\t    const limit = parsedLimit === null ? ISSUE_LIST_DEFAULT_LIMIT : clampIssueListLimit(parsedLimit);\n4667\t    const rawOffset = req.query.offset as string | undefined;\n4668\t    const parsedOffset = rawOffset !== undefined && /^\\d+$/.test(rawOffset)\n4669\t      ? Number.parseInt(rawOffset, 10)"}
{"role":"tool","tool_call_id":"tool_bL45pPZ1Uvm7n92qfyrgN02m","content":"5330\t      },\n5331\t      \"issue subtree diagnostics read\",\n5332\t    );\n5333\t\n5334\t    res.json(response);\n5335\t  });\n5336\t\n5337\t  router.get(\"/issues/:id\", async (req, res) => {\n5338\t    const id = req.params.id as string;\n5339\t    const issue = await getAccessibleResource(req, res, svc.getById(id), \"Issue not found\");\n5340\t    if (!issue) return;\n5341\t    if (!(await assertIssueReadAllowed(req, res, issue))) return;\n5342\t    const inboxArchiveFieldsPromise = req.actor.type === \"board\" && req.actor.userId\n5343\t      ? svc.getActiveInboxArchiveFields(issue, req.actor.userId)\n5344\t      : Promise.resolve({});\n5345\t    const [\n5346\t      { project, goal },\n5347\t      ancestors,\n5348\t      mentionedProjectIds,\n5349\t      documentPayload,\n5350\t      relations,\n5351\t      blockerAttention,\n5352\t      productivityReview,\n5353\t      referenceSummary,\n5354\t      successfulRunHandoffStates,\n5355\t      scheduledRetry,\n5356\t      activeRecoveryAction,\n5357\t      linkedCases,\n5358\t      inboxArchiveFields,\n5359\t    ] = await Promise.all([\n5360\t      resolveIssueProjectAndGoal(issue),\n5361\t      svc.getAncestors(issue.id),\n5362\t      svc.findMentionedProjectIds(issue.id, { includeCommentBodies: false }),\n5363\t      documentsSvc.getIssueDocumentPayload(issue),\n5364\t      svc.getRelationSummaries(issue.id),\n5365\t      svc.listBlockerAttention(issue.companyId, [issue]).then((map) => map.get(issue.id) ?? null),\n5366\t      svc.listProductivityReviews(issue.companyId, [issue.id]).then((map) => map.get(issue.id) ?? null),\n5367\t      issueReferencesSvc.listIssueReferenceSummary(issue.id),\n5368\t      listSuccessfulRunHandoffStates(db, issue.companyId, [issue.id]),\n5369\t      svc.getCurrentScheduledRetry(issue.id),\n5370\t      recoveryActionsSvc.getActiveForIssue(issue.companyId, issue.id),\n5371\t      listIssueLinkedCases(db, issue.companyId, issue.id),\n5372\t      inboxArchiveFieldsPromise,\n5373\t    ]);\n5374\t    const recoveryActionsByRelationIssue = await relationRecoveryActionMap(\n5375\t      recoveryActionsSvc,\n5376\t      issue.companyId,\n5377\t      relations,\n5378\t    );\n5379\t    const relationsWithRecoveryActions = withRecoveryActionsOnRelationSummaries(\n5380\t      relations,\n5381\t      recoveryActionsByRelationIssue,\n5382\t    );\n5383\t    const revalidatedActiveRecoveryAction = await revalidateActiveSourceRecoveryForRead({\n5384\t      issue,\n5385\t      trigger: \"read_projection\",\n5386\t      actor: getActorInfo(req),\n5387\t      activeRecoveryAction,\n5388\t    });\n5389\t    const mentionedProjects = mentionedProjectIds.length > 0\n5390\t      ? await projectsSvc.listByIds(issue.companyId, mentionedProjectIds)\n5391\t      : [];\n5392\t    const currentExecutionWorkspace = issue.executionWorkspaceId\n5393\t      ? await executionWorkspacesSvc.getById(issue.executionWorkspaceId)\n5394\t      : null;\n5395\t    const workProducts = await workProductsSvc.listForIssue(issue.id);\n5396\t    res.json({\n5397\t      ...issue,\n5398\t      ...inboxArchiveFields,\n5399\t      goalId: goal?.id ?? issue.goalId,\n5400\t      ancestors,\n5401\t      ...(blockerAttention ? { blockerAttention } : {}),\n5402\t      productivityReview,\n5403\t      successfulRunHandoff: successfulRunHandoffStates.get(issue.id) ?? null,\n5404\t      scheduledRetry,\n5405\t      activeRecoveryAction: revalidatedActiveRecoveryAction,\n5406\t      blockedBy: relationsWithRecoveryActions.blockedBy,\n5407\t      blocks: relationsWithRecoveryActions.blocks,\n5408\t      relatedWork: referenceSummary,\n5409\t      referencedIssueIdentifiers: referenceSummary.outbound.map((item) => item.issue.identifier ?? item.issue.id),\n5410\t      ...documentPayload,\n5411\t      project: compactIssueProject(project),\n5412\t      goal: goal ?? null,\n5413\t      mentionedProjects,\n5414\t      currentExecutionWorkspace: compactIssueExecutionWorkspace(currentExecutionWorkspace),\n5415\t      workProducts,\n5416\t      linkedCases,\n5417\t    });\n5418\t  });\n5419\t\n5420\t  router.get(\"/issues/:id/watchdog\", async (req, res) => {\n5421\t    const id = req.params.id as string;\n5422\t    const issue = await getAccessibleResource(req, res, svc.getById(id), \"Issue not found\");\n5423\t    if (!issue) return;\n5424\t    if (!(await assertIssueReadAllowed(req, res, issue))) return;\n5425\t    res.json(await taskWatchdogsSvc.getActiveForIssue(issue.companyId, issue.id));\n5426\t  });\n5427\t\n5428\t  router.put(\"/issues/:id/watchdog\", validate(upsertIssueWatchdogSchema), async (req, res) => {\n5429\t    const id = req.params.id as string;\n5430\t    const issue = await getAccessibleResource(req, res, svc.getById(id), \"Issue not found\");\n5431\t    if (!issue) return;\n5432\t    if (!(await assertIssueReadAllowed(req, res, issue))) return;\n5433\t    if (!(await assertAgentIssueMutationAllowed(req, res, issue))) return;\n5434\t    if (await rejectTaskWatchdogConfigMutation(req, res)) return;\n5435\t    if (await assertLowTrustControlPlaneDenied(req, res, issue.companyId, issue)) return;\n5436\t\n5437\t    const actor = getActorInfo(req);\n5438\t    const existingWatchdog = await taskWatchdogsSvc.getActiveForIssue(issue.companyId, issue.id);\n5439\t    const { watchdog, created } = await taskWatchdogsSvc.upsertForIssue(issue.companyId, issue.id, {\n5440\t      agentId: req.body.agentId,\n5441\t      instructions: req.body.instructions,\n5442\t      actor: {\n5443\t        agentId: actor.agentId,\n5444\t        userId: actor.actorType === \"user\" ? actor.actorId : null,\n5445\t        runId: actor.runId,\n5446\t      },\n5447\t    });\n5448\t    await logActivity(db, {\n5449\t      companyId: issue.companyId,"}
{"role":"tool","tool_call_id":"tool_z1bfEBAW9wZroeqiWkgtV04Y","content":"1\timport express, { Router, type Request as ExpressRequest } from \"express\";\n2\timport path from \"node:path\";\n3\timport fs from \"node:fs\";\n4\timport { fileURLToPath } from \"node:url\";\n5\timport type { Db } from \"@paperclipai/db\";\n6\timport type { DeploymentExposure, DeploymentMode } from \"@paperclipai/shared\";\n7\timport type { InspectDatabaseBackupHealthOptions } from \"./services/database-backup-health.js\";\n8\timport type { StorageService } from \"./storage/types.js\";\n9\timport { httpLogger, errorHandler } from \"./middleware/index.js\";\n10\timport { actorMiddleware } from \"./middleware/auth.js\";\n11\timport { boardMutationGuard } from \"./middleware/board-mutation-guard.js\";\n12\timport { privateHostnameGuard, resolvePrivateHostnameAllowSet } from \"./middleware/private-hostname-guard.js\";\n13\timport { applyTrustProxy, parseTrustProxyEnv } from \"./middleware/trust-proxy.js\";\n14\timport { healthRoutes } from \"./routes/health.js\";\n15\timport { companyRoutes } from \"./routes/companies.js\";\n16\timport { companySkillRoutes } from \"./routes/company-skills.js\";\n17\timport { companySkillPolicyRoutes } from \"./routes/company-skill-policy.js\";\n18\timport { inboxAgentPolicyRoutes } from \"./routes/inbox-agent-policy.js\";\n19\timport { builtInAgentRoutes } from \"./routes/built-in-agents.js\";\n20\timport { folderRoutes } from \"./routes/folders.js\";\n21\timport { summarySlotRoutes } from \"./routes/summary-slots.js\";\n22\timport { teamsCatalogRoutes } from \"./routes/teams-catalog.js\";\n23\timport { agentRoutes } from \"./routes/agents.js\";\n24\timport { projectRoutes } from \"./routes/projects.js\";\n25\timport { issueRoutes } from \"./routes/issues.js\";\n26\timport { issueTreeControlRoutes } from \"./routes/issue-tree-control.js\";\n27\timport { caseRoutes } from \"./routes/cases.js\";\n28\timport { fileResourceRoutes } from \"./routes/file-resources.js\";\n29\timport { routineRoutes } from \"./routes/routines.js\";\n30\timport { pipelineRoutes } from \"./routes/pipelines.js\";\n31\timport { environmentRoutes } from \"./routes/environments.js\";\n32\timport { executionWorkspaceRoutes } from \"./routes/execution-workspaces.js\";\n33\timport { goalRoutes } from \"./routes/goals.js\";\n34\timport { boardChatRoutes } from \"./routes/board-chat.js\";\n35\timport { approvalRoutes } from \"./routes/approvals.js\";\n36\timport { secretRoutes } from \"./routes/secrets.js\";\n37\timport { toolAccessRoutes } from \"./routes/tool-access.js\";\n38\timport { smokeLabRoutes } from \"./routes/smoke-lab.js\";\n39\timport { costRoutes } from \"./routes/costs.js\";\n40\timport { activityRoutes } from \"./routes/activity.js\";\n41\timport { dashboardRoutes } from \"./routes/dashboard.js\";\n42\timport { attentionRoutes } from \"./routes/attention.js\";\n43\timport { decisionTrainingRoutes } from \"./routes/decision-training.js\";\n44\timport { userProfileRoutes } from \"./routes/user-profiles.js\";\n45\timport { sidebarBadgeRoutes } from \"./routes/sidebar-badges.js\";\n46\timport { sidebarPreferenceRoutes } from \"./routes/sidebar-preferences.js\";\n47\timport { resourceMembershipRoutes } from \"./routes/resource-memberships.js\";\n48\timport { inboxDismissalRoutes } from \"./routes/inbox-dismissals.js\";\n49\timport { instanceSettingsRoutes } from \"./routes/instance-settings.js\";\n50\timport { openApiRoutes } from \"./routes/openapi.js\";\n51\timport {\n52\t  instanceDatabaseBackupRoutes,\n53\t  type InstanceDatabaseBackupService,\n54\t} from \"./routes/instance-database-backups.js\";\n55\timport { llmRoutes } from \"./routes/llms.js\";\n56\timport { authRoutes } from \"./routes/auth.js\";\n57\timport { assetRoutes } from \"./routes/assets.js\";\n58\timport { accessRoutes } from \"./routes/access.js\";\n59\timport { pluginRoutes } from \"./routes/plugins.js\";\n60\timport { mcpGatewayProtocolRoutes, toolGatewayRoutes } from \"./routes/tool-gateway.js\";\n61\timport { adapterRoutes } from \"./routes/adapters.js\";\n62\timport { pluginUiStaticRoutes } from \"./routes/plugin-ui-static.js\";\n63\timport { readBrandedStaticIndexHtml } from \"./static-index-html.js\";\n64\timport { applyUiBranding } from \"./ui-branding.js\";\n65\timport { logger } from \"./middleware/logger.js\";\n66\timport { DEFAULT_LOCAL_PLUGIN_DIR, pluginLoader } from \"./services/plugin-loader.js\";\n67\timport { createPluginWorkerManager, type PluginWorkerManager } from \"./services/plugin-worker-manager.js\";\n68\timport { createPluginJobScheduler } from \"./services/plugin-job-scheduler.js\";\n69\timport { pluginJobStore } from \"./services/plugin-job-store.js\";\n70\timport { createPluginToolDispatcher } from \"./services/plugin-tool-dispatcher.js\";\n71\timport { createToolGatewayService } from \"./services/tool-gateway.js\";\n72\timport { pluginLifecycleManager } from \"./services/plugin-lifecycle.js\";\n73\timport { createPluginJobCoordinator } from \"./services/plugin-job-coordinator.js\";\n74\timport { buildHostServices, flushPluginLogBuffer } from \"./services/plugin-host-services.js\";\n75\timport { createPluginEventBus } from \"./services/plugin-event-bus.js\";\n76\timport { setPluginEventBus } from \"./services/activity-log.js\";\n77\timport { createPluginDevWatcher } from \"./services/plugin-dev-watcher.js\";\n78\timport { createPluginHostServiceCleanup } from \"./services/plugin-host-service-cleanup.js\";\n79\timport { pluginRegistryService } from \"./services/plugin-registry.js\";\n80\timport { createHostClientHandlers } from \"@paperclipai/plugin-sdk\";\n81\timport type { BetterAuthSessionResult } from \"./auth/better-auth.js\";\n82\timport { createCachedViteHtmlRenderer } from \"./vite-html-renderer.js\";\n83\timport { DEFAULT_JSON_BODY_LIMIT, PORTABLE_JSON_BODY_LIMIT } from \"./http/body-limits.js\";\n84\timport { COMPANY_IMPORT_API_PATH } from \"./routes/company-import-paths.js\";\n85\timport { apiCompression } from \"./middleware/api-compression.js\";\n86\t\n87\ttype UiMode = \"none\" | \"static\" | \"vite-dev\";\n88\tconst FEEDBACK_EXPORT_FLUSH_INTERVAL_MS = 5_000;\n89\tconst VITE_DEV_ASSET_PREFIXES = [\n90\t  \"/@fs/\",\n91\t  \"/@id/\",\n92\t  \"/@react-refresh\",\n93\t  \"/@vite/\",\n94\t  \"/assets/\",\n95\t  \"/node_modules/\",\n96\t  \"/src/\",\n97\t];\n98\tconst VITE_DEV_STATIC_PATHS = new Set([\n99\t  \"/apple-touch-icon.png\",\n100\t  \"/favicon-16x16.png\",\n101\t  \"/favicon-32x32.png\",\n102\t  \"/favicon.ico\",\n103\t  \"/favicon.svg\",\n104\t  \"/site.webmanifest\",\n105\t  \"/sw.js\",\n106\t]);\n107\t\n108\texport function isDatabaseConnectionUnavailableError(err: unknown): boolean {\n109\t  const error = err as { code?: unknown; message?: unknown; cause?: unknown };\n110\t  if (error?.code === \"ECONNREFUSED\") return true;\n111\t  return Boolean(error?.cause && isDatabaseConnectionUnavailableError(error.cause));\n112\t}\n113\t\n114\texport function resolveViteHmrPort(serverPort: number): number {\n115\t  if (serverPort <= 55_535) {\n116\t    return serverPort + 10_000;\n117\t  }\n118\t  return Math.max(1_024, serverPort - 10_000);\n119\t}\n120\t\n121\texport function resolveViteHmrHost(bindHost: string): string | undefined {\n122\t  const normalized = bindHost.trim().toLowerCase();\n123\t  if (normalized === \"0.0.0.0\" || normalized === \"::\") return undefined;\n124\t  return bindHost;\n125\t}\n126\t\n127\texport function shouldServeViteDevHtml(req: ExpressRequest): boolean {\n128\t  const pathname = req.path;\n129\t  if (VITE_DEV_STATIC_PATHS.has(pathname)) return false;\n130\t  if (VITE_DEV_ASSET_PREFIXES.some((prefix) => pathname.startsWith(prefix))) return false;\n131\t  return req.accepts([\"html\"]) === \"html\";\n132\t}\n133\t\n134\texport function shouldEnablePrivateHostnameGuard(opts: {\n135\t  deploymentMode: DeploymentMode;\n136\t  deploymentExposure: DeploymentExposure;\n137\t}): boolean {\n138\t  return (\n139\t    opts.deploymentExposure === \"private\" &&\n140\t    (opts.deploymentMode === \"local_trusted\" || opts.deploymentMode === \"authenticated\")\n141\t  );\n142\t}\n143\t\n144\texport async function createApp(\n145\t  db: Db,\n146\t  opts: {\n147\t    uiMode: UiMode;\n148\t    serverPort: number;\n149\t    storageService: StorageService;\n150\t    feedbackExportService?: {\n151\t      flushPendingFeedbackTraces(input?: {\n152\t        companyId?: string;\n153\t        traceId?: string;\n154\t        limit?: number;\n155\t        now?: Date;\n156\t      }): Promise<unknown>;\n157\t    };\n158\t    databaseBackupService?: InstanceDatabaseBackupService;\n159\t    databaseBackupHealth?: InspectDatabaseBackupHealthOptions;\n160\t    deploymentMode: DeploymentMode;\n161\t    deploymentExposure: DeploymentExposure;\n162\t    allowedHostnames: string[];\n163\t    bindHost: string;\n164\t    authReady: boolean;\n165\t    companyDeletionEnabled: boolean;\n166\t    instanceId?: string;\n167\t    hostVersion?: string;\n168\t    localPluginDir?: string;\n169\t    pluginMigrationDb?: Db;\n170\t    pluginWorkerManager?: PluginWorkerManager;\n171\t    betterAuthHandler?: express.RequestHandler;\n172\t    resolveSession?: (req: ExpressRequest) => Promise<BetterAuthSessionResult | null>;\n173\t  },\n174\t) {\n175\t  const app = express();\n176\t  app.locals.paperclipDb = db;\n177\t  const captureRawBody = (req: express.Request, _res: express.Response, buf: Buffer) => {\n178\t    (req as unknown as { rawBody: Buffer }).rawBody = buf;\n179\t  };\n180\t\n181\t  // Respect the operator's `TRUST_PROXY` env var (see middleware/trust-proxy.ts).\n182\t  // Default is unset → Express trusts nothing, which is the only safe choice\n183\t  // when the server may be reachable without a known reverse proxy in front.\n184\t  applyTrustProxy(app, parseTrustProxyEnv(process.env.TRUST_PROXY));\n185\t\n186\t  app.use(COMPANY_IMPORT_API_PATH, express.json({\n187\t    limit: PORTABLE_JSON_BODY_LIMIT,\n188\t    verify: cap